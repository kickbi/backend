# Local Development Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# AWS Configuration (for local Secrets Manager access)
AWS_LAMBDA_REGION=""

AWS_LAMBDA_ACCESS_KEY_ID=""
AWS_LAMBDA_SECRET_ACCESS_KEY=""

AWS_SECRET_NAME=""

# Secrets Manager (set to fetch secrets from AWS Secrets Manager)
# SECRET_NAME=dev-kickbi-secrets

# App-specific overrides (these override Secrets Manager values locally)
# DB_HOST=localhost
# DB_PASSWORD=your-local-password
# DB_NAME=kickbi
